# SafeLease AI 환경변수 템플릿
# 본 파일을 복사하여 .env 파일을 생성하고 실제 키를 입력하세요.

# Gemini API Key (독소조항 심층 추론 및 완곡한 협상 문구 생성용)
GEMINI_API_KEY="your-gemini-api-key-here"

# 애플리케이션 모드 (development / production)
APP_ENV="development"

# 로그 레벨 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL="INFO"

# 히스토리 데이터베이스 파일명
DB_NAME="safe_lease.db"

# 서비스 접속 URL (미설정 시 로컬 IP 자동 감지 또는 Vercel 도메인 자동 반영)
# APP_URL="https://your-domain.vercel.app"
